# Quelltexte und Textdateien sind UTF-8 ohne BOM mit CRLF,
# so wie sie auf den Sender kommen.
*.lua  text eol=crlf
*.txt  text eol=crlf

*.md            text eol=lf
.gitattributes  text eol=lf
.gitignore      text eol=lf

*.wav   binary
*.docx  binary
*.pdf   binary
*.png   binary
*.jpg   binary
*.jpeg  binary
*.emf   binary
*.luac  binary
*.zip   binary
